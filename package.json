{
  "name": "sable-matrix-client-electron",
  "productName": "Sable",
  "version": "0.0.1",
  "description": "Electron wrapper for Sable Client",
  "type": "module",
  "main": "./app/main.js",
  "author": "7w1 <hi@sable.moe>",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "moe.sable.app",
    "productName": "Sable",
    "directories": {
      "output": "dist",
      "buildResources": "./app"
    },
    "extraResources": [
      "app/icons/**/*"
    ],
    "files": [
      "app/main.js",
      "app/preload.js",
      "package.json"
    ],
    "win": {
      "icon": "icons/favicon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "icons/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "icons/favicon.png",
      "target": [
        "AppImage",
        "deb",
        "flatpak"
      ],
      "category": "Chat"
    },
    "flatpak": {
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "24.08",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk",
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--device=all",
        "--socket=pulseaudio",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications"
      ]
    }
  }
}